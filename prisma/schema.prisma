generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Required for creating a User: id, name, email, image, cart (optional JSON string)

model User {
  id    String @id
  name  String
  email String
  image String
  phone String?  // phone number for USSD lookups (E.164 format: +232...)
  ussdPinHash String?  // bcrypt hash of 4-digit USSD PIN
  ussdPinSetAt DateTime? // when the PIN was last changed
  cart  Json

  // Relations
  ratings              Rating[]
  Address              Address[]
  store                Store?
  buyerOrders          Order[]          @relation("BuyerRelation")
  emailVerified        Boolean          @default(false)
  membershipTier       String?
  membershipStatus     String?          @default("inactive")
  membershipProviderId String?
  membershipStartedAt  DateTime?
  membershipEndsAt     DateTime?
  // Account-closure / AML retention markers. When an account is closed the
  // row is soft-deleted (never hard-deleted): deletedAt is set and
  // dataRetentionUntil marks deletedAt + 5 years, so orders, payments and
  // wallet history remain available for law-enforcement requests.
  deletedAt            DateTime?
  dataRetentionUntil   DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  sessions             Session[]
  deviceSessions       DeviceSession[]
  accounts             Account[]
  payments             Payment[]
  wallet               Wallet?
  pspTransactions      PspTransaction[]
  disputes             Dispute[]
  fraudEvents          FraudEvent[]
  agent                Agent?
  paymentCodes         PaymentCode[]
  cardPayments         CardPayment[]

  @@index([deletedAt])
  @@map("user")
}

// Required for creating a Product: name, description, mrp, price, images, category, storeId

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String
  mrp            Float
  price          Float
  halalCertified Boolean  @default(false)
  images         Json
  category       String
  inStock        Boolean  @default(true)
  stock          Int? // null = unlimited; atomic decrement guards overselling
  soldCount      Int      @default(0) // cumulative units sold; shown as social proof
  storeId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  rating     Rating[]
}

enum OrderStatus {
  ORDER_PLACED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum PaymentMethod {
  COD
  // Retained for historical orders. The DB enum still contains it and old rows
  // use it; removing it would break reading those orders. New checkouts only
  // use COD/WALLET.
  STRIPE
  FLUTTERWAVE
  WALLET
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ─── PSP state machine ───────────────────────────────────────────────────────
// Explicit states for the payment lifecycle as a licensed processor.
// Every transition must go through assertValidPspTransition(); no other
// code path may write to psp_status directly.
//
//   pending → authorized → captured → settled
//                    ↘ failed
//   captured → refund_pending → refunded
//   captured → disputed → resolved (back to captured or refund_pending)
enum PspStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  SETTLED
  FAILED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  RESOLVED
}

enum SettlementStatus {
  PENDING
  SENT
  CONFIRMED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_FOR_BUYER
  RESOLVED_FOR_SELLER
  ESCALATED
}

enum MerchantVerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum FraudAction {
  ALLOW
  FLAG
  BLOCK
  MANUAL_REVIEW
}

// ─── PSP Transaction ─────────────────────────────────────────────────────────
// One row per payment lifecycle event as a licensed processor.
// Extends the existing Payment model with explicit PSP states.
// version column enables optimistic concurrency — every UPDATE must
// include WHERE version = :expectedVersion.
model PspTransaction {
  id             String    @id @default(cuid())
  paymentId      String    @unique // links to existing Payment model
  merchantId     String // storeId = merchant for ABU marketplace
  userId         String
  amount         Float // authorized amount (never changes after creation)
  capturedAmount Float // amount actually captured (<= amount)
  settledAmount  Float // amount actually settled to merchant
  currency       String    @default("USD")
  pspStatus      PspStatus @default(PENDING)
  version        Int       @default(1) // optimistic concurrency
  idempotencyKey String    @unique
  providerRef    String?   @unique // provider transaction reference
  authorizedAt   DateTime?
  capturedAt     DateTime?
  settledAt      DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payment           Payment          @relation(fields: [paymentId], references: [id])
  merchant          Store            @relation(fields: [merchantId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  ledger            LedgerEntry[]
  auditLogs         AuditLog[]
  disputes          Dispute[]
  settlementBatch   SettlementBatch? @relation(fields: [settlementBatchId], references: [id])
  settlementBatchId String?

  @@index([merchantId])
  @@index([userId])
  @@index([pspStatus])
  @@index([createdAt])
  @@map("psp_transaction")
}

// ─── Double-entry ledger ──────────────────────────────────────────────────────
// Every money movement recorded as a paired entry (debit + credit, always
// summing to zero). Accounts: customer_receivable, merchant_payable,
// platform_revenue, network_fees.
model LedgerEntry {
  id               String   @id @default(cuid())
  pspTransactionId String
  account          String // customer_receivable | merchant_payable | platform_revenue | network_fees
  debit            Float    @default(0)
  credit           Float    @default(0)
  description      String?
  referenceType    String // "psp_transaction" | "settlement" | "refund" | "dispute"
  referenceId      String
  createdAt        DateTime @default(now())

  pspTransaction    PspTransaction?  @relation(fields: [pspTransactionId], references: [id])
  settlementBatch   SettlementBatch? @relation(fields: [settlementBatchId], references: [id])
  settlementBatchId String?

  @@index([pspTransactionId])
  @@index([account])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("ledger_entry")
}

// ─── Append-only audit log ────────────────────────────────────────────────────
// Every payment-state-changing action logged with old/new state.
// No updates or deletes at the application level.
model AuditLog {
  id               String   @id @default(cuid())
  pspTransactionId String?
  actor            String // "system" | "webhook" | userId | "admin"
  action           String // "authorize" | "capture" | "settle" | "fail" | "refund" | "dispute" | "resolve"
  previousState    String?
  newState         String?
  metadata         Json? // additional context (amounts, provider refs, etc.)
  ipAddress        String?
  createdAt        DateTime @default(now())

  pspTransaction PspTransaction? @relation(fields: [pspTransactionId], references: [id])
  dispute        Dispute?        @relation(fields: [disputeId], references: [id])
  disputeId      String?

  @@index([pspTransactionId])
  @@index([actor])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── Settlement batches ───────────────────────────────────────────────────────
// Groups captured transactions per merchant for payout.
model SettlementBatch {
  id            String           @id @default(cuid())
  merchantId    String
  status        SettlementStatus @default(PENDING)
  grossAmount   Float // total captured before fees
  platformFee   Float // ABU marketplace fee
  netAmount     Float // grossAmount - platformFee
  currency      String           @default("USD")
  payoutRef     String? // bank/mobile money reference
  payoutAccount Json? // { type: "bank"|"mobile", ... }
  scheduledAt   DateTime         @default(now())
  sentAt        DateTime?
  confirmedAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  retryCount    Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  merchant     Store            @relation(fields: [merchantId], references: [id])
  ledger       LedgerEntry[]
  transactions PspTransaction[]

  @@index([merchantId])
  @@index([status])
  @@index([scheduledAt])
  @@map("settlement_batch")
}

// ─── Disputes / chargebacks ───────────────────────────────────────────────────
model Dispute {
  id               String        @id @default(cuid())
  pspTransactionId String
  userId           String
  reason           String
  status           DisputeStatus @default(OPEN)
  amount           Float // disputed amount
  resolution       String? // buyer/seller/explanation
  evidence         Json? // supporting documents/notes
  openedAt         DateTime      @default(now())
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  pspTransaction PspTransaction @relation(fields: [pspTransactionId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  auditLogs      AuditLog[]

  @@index([pspTransactionId])
  @@index([userId])
  @@index([status])
  @@map("dispute")
}

// ─── Fraud events ─────────────────────────────────────────────────────────────
// Logged per checkout attempt for risk scoring and BSL reporting.
model FraudEvent {
  id               String      @id @default(cuid())
  userId           String
  pspTransactionId String?
  eventType        String // velocity | new_account_high_value | mismatch | ip_device
  riskScore        Float       @default(0) // 0-100
  action           FraudAction @default(ALLOW)
  details          Json // { ip, deviceFingerprint, orderAmount, ... }
  reviewedBy       String? // admin userId if manually reviewed
  reviewNote       String?
  createdAt        DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([eventType])
  @@index([action])
  @@index([createdAt])
  @@map("fraud_event")
}

// ─── Merchant onboarding ──────────────────────────────────────────────────────
// Extends Store with KYC and compliance fields for multi-merchant PSP.
model MerchantProfile {
  id                 String                     @id @default(cuid())
  storeId            String                     @unique
  verificationStatus MerchantVerificationStatus @default(UNVERIFIED)
  riskTier           String                     @default("new") // new | standard | established
  businessRegNumber  String?
  beneficialOwners   Json? // [{ name, id, ownership % }]
  bankAccount        Json? // { type, accountNumber, bank, ... }
  mobileMoneyAccount Json? // { provider, number, ... }
  dailyLimit         Float                      @default(1000) // USD
  monthlyLimit       Float                      @default(25000) // USD
  kycDocuments       Json? // uploaded doc references
  verifiedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@map("merchant_profile")
}

// ─── Idempotency keys (standalone) ───────────────────────────────────────────
// Dedicated table for idempotency tracking across all endpoints.
model IdempotencyKeyRecord {
  key          String   @id
  requestHash  String // SHA-256 of the request body
  responseBody String? // cached response for replay
  status       String   @default("pending") // pending | processed | conflict
  createdAt    DateTime @default(now())
  expiresAt    DateTime // TTL for cleanup

  @@index([expiresAt])
  @@map("idempotency_key_record")
}

// Required for creating an Order: total, userId, storeId, addressId, isPaid, paymentMethod, isCouponUsed, coupon (JSON), orderItems (nested)

model Order {
  id            String        @id @default(cuid())
  total         Float
  status        OrderStatus   @default(ORDER_PLACED)
  userId        String
  storeId       String
  addressId     String
  isPaid        Boolean       @default(false)
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isCouponUsed  Boolean       @default(false)
  coupon        Json
  paymentId     String?
  paymentStatus PaymentStatus @default(PENDING)
  orderItems    OrderItem[]

  // Relations
  user    User     @relation("BuyerRelation", fields: [userId], references: [id])
  store   Store    @relation(fields: [storeId], references: [id])
  address Address  @relation(fields: [addressId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId, paymentId])
}

// Required for creating an OrderItem: orderId, productId, quantity, price

model OrderItem {
  orderId   String
  productId String
  quantity  Int
  price     Float

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
}

// Required for creating a Rating: rating, review, userId, productId

model Rating {
  id        String   @id @default(cuid())
  rating    Int
  review    String
  userId    String
  productId String
  orderId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
}

// Required for creating an Address: userId, name, email, street, city, state, zip, country, phone

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String
  street    String
  city      String
  state     String
  zip       String
  country   String
  phone     String
  createdAt DateTime @default(now())

  // Relations
  Order Order[]
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Required for creating a Coupon: code, description, discount, forNewUser, isPublic, expiresAt

model Coupon {
  code        String   @id
  description String
  discount    Float
  forNewUser  Boolean
  forMember   Boolean  @default(false)
  isPublic    Boolean
  expiresAt   DateTime
  maxUses     Int?
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
}

// Required for creating a Store: userId, name, username, email, contact, logo, description, address (optional: , status, isActive)

model Store {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  description    String
  username       String   @unique
  address        String
  status         String   @default("pending")
  isActive       Boolean  @default(false)
  logo           String
  email          String
  contact        String
  halalCertified Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Product           Product[]
  Order             Order[]
  user              User              @relation(fields: [userId], references: [id])
  pspTransactions   PspTransaction[]
  settlementBatches SettlementBatch[]
  merchantProfile   MerchantProfile?
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @unique // SHA-256 hash of the raw token (never stored in plaintext)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Support tickets and messages for customer support
model SupportTicket {
  id              String   @id @default(cuid())
  userId          String?
  subject         String
  status          String   @default("open")
  accessTokenHash String? // SHA-256 hash of the bearer token (raw token never stored)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  sender    String // 'user' | 'abu' | 'agent'
  content   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ─── Payment hardening models ─────────────────────────────────────────────────

// One Payment row per checkout attempt. `idempotencyKey` is unique at the
// database level so concurrent duplicate checkouts can never create two
// charges. Provider identifiers are unique to make webhooks/refunds idempotent.
model Payment {
  id                      String        @id @default(cuid())
  idempotencyKey          String        @unique
  userId                  String
  providerSessionId       String?       @unique
  providerSessionUrl      String?
  providerPaymentIntentId String?       @unique
  providerTransactionId   String?       @unique
  currency                String        @default("USD")
  amount                  Float
  status                  PaymentStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  orders         Order[]
  refunds        Refund[]
  pspTransaction PspTransaction?

  @@index([userId])
  @@index([status])
  @@map("payment")
}

// Idempotent refund ledger. `providerRefundId` is unique so a refund can never
// be issued twice for the same provider transaction.
model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  amount           Float
  status           String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  providerRefundId String?  @unique
  reason           String?
  createdAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refund")
}

// Deduplication ledger for provider webhook events (replay protection).
model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String   @default("amber_pay")
  providerEventId String   @unique
  type            String
  processedAt     DateTime @default(now())

  @@index([provider, providerEventId])
  @@map("webhook_event")
}

// ─── AMBER PAY — Wallet ──────────────────────────────────────────────────────
// One wallet per user, holding the canonical (USD) balance. All mutations go
// through atomic conditional updates so balances can never go negative and a
// top-up/checkout can never be applied twice.
// 
// AMBER PAY is the marketplace's in-house financial system, inspired by
// Vult (Sierra Leone's digital banking super app). Users fund their wallet
// via agent cash-in, then spend at checkout or send P2P.
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0) // canonical USD balance
  sllBalance Float   @default(0) // Sierra Leonean Leone balance (display-only, converted from USD)
  status    String   @default("active") // active | frozen | closed
  frozenAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
  topUpRequests TopUpRequest[]
  withdrawalRequests WithdrawalRequest[]
  sentTransfers P2PTransfer[] @relation("senderTransfers")
  receivedTransfers P2PTransfer[] @relation("receiverTransfers")
  cardPayments CardPayment[]

  @@map("wallet")
}

// ─── AMBER PAY — Wallet Transaction Ledger ───────────────────────────────────
// Immutable audit ledger. (referenceType, referenceId) is unique so the same
// top-up, checkout, or transfer can never be recorded twice.
// 
// Transaction types:
//   TOPUP        — cash-in via agent, bank deposit (future)
//   PAYMENT      — marketplace checkout
//   P2P_SEND     — peer-to-peer transfer (sender side)
//   P2P_RECEIVE  — peer-to-peer transfer (receiver side)
//   WITHDRAWAL   — cash-out via agent
//   REFUND       — order refund
//   FEE          — platform fee deduction
model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  userId        String
  type          String // TOPUP | PAYMENT | P2P_SEND | P2P_RECEIVE | WITHDRAWAL | REFUND | FEE
  amount        Float // positive = credit, negative = debit
  balanceAfter  Float
  currency      String  @default("USD") // USD | SLL
  referenceType String? // "order" | "p2p_transfer" | "topup_request" | "agent_transaction" | "settlement"
  referenceId   String?
  description   String?
  metadata      Json?   // extra context (agent ID, recipient info, etc.)
  createdAt     DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([referenceType, referenceId])
  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@map("wallet_transaction")
}

// ─── AMBER PAY — Agent Network ────────────────────────────────────────────────
// Agents are physical cash-in/cash-out locations (like Vult's agent network).
// Users deposit cash at an agent to fund their wallet, or withdraw cash.
// Agents earn a commission on each transaction.
model Agent {
  id              String   @id @default(cuid())
  userId          String   @unique // the agent's own user account
  businessName    String
  location        String // physical address / area
  city            String
  region          String // province/district
  phone           String
  status          String   @default("pending") // pending | active | suspended | closed
  dailyLimit      Float    @default(5000) // max cash-in per day in USD
  monthlyLimit    Float    @default(50000) // max cash-in per month in USD
  commissionRate  Float    @default(0.02) // 2% commission on each transaction
  floatBalance    Float    @default(0) // agent's own cash float
  verifiedAt      DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  user          User                @relation(fields: [userId], references: [id])
  transactions  AgentTransaction[]
  topUpRequests TopUpRequest[]
  withdrawalRequests WithdrawalRequest[]

  @@map("agent")
}

// ─── AMBER PAY — Agent Transactions ───────────────────────────────────────────
// Records every cash-in / cash-out operation at an agent location.
model AgentTransaction {
  id          String   @id @default(cuid())
  agentId     String
  userId      String // the customer whose wallet is being funded/withdrawn
  type        String // CASH_IN | CASH_OUT
  amount      Float // amount in USD
  fee         Float  @default(0) // agent commission
  status      String  @default("pending") // pending | confirmed | failed
  agentRef    String? @unique // unique reference code shown to agent
  notes       String?
  confirmedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([userId])
  @@index([status])
  @@map("agent_transaction")
}

// ─── AMBER PAY — Top-Up Requests ─────────────────────────────────────────────
// When a user wants to fund their wallet, they create a top-up request.
// An agent sees pending requests nearby and processes them (cash-in).
// This is the "Agent Request" feature from Vult's version history.
model TopUpRequest {
  id          String   @id @default(cuid())
  walletId    String
  userId      String
  agentId     String? // assigned agent (null until an agent picks it up)
  amount      Float // requested amount in USD
  currency    String  @default("USD")
  status      String  @default("pending") // pending | matched | processing | completed | expired | cancelled
  agentRef    String? @unique // code the user shows the agent
  notes       String?
  matchedAt   DateTime?
  completedAt DateTime?
  expiredAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])
  agent  Agent? @relation(fields: [agentId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@map("topup_request")
}

// ─── AMBER PAY — Withdrawal Requests ────────────────────────────────────────
// When a user wants to withdraw cash from their wallet, they create a
// withdrawal request. An agent nearby sees the request, hands over cash,
// and the user's wallet is debited.
model WithdrawalRequest {
  id          String   @id @default(cuid())
  walletId    String
  userId      String
  agentId     String? // assigned agent (null until an agent picks it up)
  amount      Float // requested amount in USD
  currency    String  @default("USD")
  status      String  @default("pending") // pending | matched | processing | completed | expired | cancelled
  agentRef    String? @unique // code the user shows the agent
  notes       String?
  matchedAt   DateTime?
  completedAt DateTime?
  expiredAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])
  agent  Agent? @relation(fields: [agentId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@map("withdrawal_request")
}

// ─── AMBER PAY — P2P Transfers ───────────────────────────────────────────────
// Send money between AMBER PAY users. Instant wallet-to-wallet.
model P2PTransfer {
  id            String   @id @default(cuid())
  senderId      String
  receiverId    String
  senderWalletId    String
  receiverWalletId  String
  amount        Float // amount in USD
  fee           Float  @default(0) // platform fee
  netAmount     Float // amount received (amount - fee)
  currency      String  @default("USD")
  description   String?
  status        String  @default("pending") // pending | completed | failed | reversed
  idempotencyKey String @unique
  completedAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  senderWallet   Wallet @relation("senderTransfers", fields: [senderWalletId], references: [id])
  receiverWallet Wallet @relation("receiverTransfers", fields: [receiverWalletId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("p2p_transfer")
}

// ─── AMBER PAY — Payment Codes ───────────────────────────────────────────────
// Code-based payment flow (Monime/Vult style):
//   1. Web app generates a code (e.g. "7X3K9M")
//   2. User dials *123*7X3K9M# on their phone
//   3. USSD prompts: pick Orange Money or Afrimoney
//   4. User enters their mobile money PIN
//   5. Transaction is processed, wallet is credited
model PaymentCode {
  id            String   @id @default(cuid())   code          String   @unique // 10-digit numeric code (e.g. "8372910456")
  userId        String
  amount        Float // amount in USD
  currency      String   @default("USD")
  type          String // DEPOSIT | WITHDRAWAL | CHECKOUT
  provider      String? // orange_money | afrimoney (set after user selects)
  status        String   @default("pending") // pending | provider_selected | processing | completed | expired | failed
  mobileRef     String? // mobile money transaction reference
  expiresAt     DateTime // code expires after 10 minutes
  completedAt   DateTime?
  failedAt      DateTime?
  failureReason String?
  metadata      Json?   // extra context
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([code])
  @@index([userId])
  @@index([status])
  @@map("payment_code")
}

// ─── AMBER PAY — Card Payments ───────────────────────────────────────────────
// Prepaid and debit card top-ups for wallet funding.
// Card details are tokenized — only last 4 digits and card brand are stored.
model CardPayment {
  id              String   @id @default(cuid())
  userId          String
  walletId        String
  amount          Float    // amount in USD
  currency        String   @default("USD")
  cardLast4       String   // last 4 digits of card number
  cardBrand       String   // visa | mastercard | amex | other
  cardType        String   // prepaid | debit | credit
  status          String   @default("pending") // pending | processing | completed | failed | expired
  providerRef     String?  @unique // card processor transaction reference
  authorizationCode String? // card authorization code
  responseCode    String?   // processor response code
  responseMessage String?   // processor response message
  expiresAt       DateTime // payment link expires after 10 minutes
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  metadata        Json?    // extra context (IP, device, etc.)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([cardLast4])
  @@map("card_payment")
}

// ─── Rate limiting ────────────────────────────────────────────────────────────
// Distributed fixed-window counters shared across serverless instances (the
// in-memory Maps are single-instance only). Key = "{namespace}:{identifier}".
// Rows are short-lived and swept by the Inngest cleanup job.
model RateLimitEntry {
  id          String   @id @default(cuid())
  key         String   @unique
  windowStart DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
  @@map("rate_limit_entry")
}

// ─── Device fingerprint tracking (session-hijack detection) ────────────────
// One row per known device for a user. When a sign-in happens from an
// unrecognized fingerprint the system sends an alert email to the account
// owner. The lastSeenAt timestamp is updated on every match so stale
// devices can be swept later.
model DeviceSession {
  id              String   @id @default(cuid())
  userId          String
  fingerprintHash String // SHA-256 prefix (16 hex chars) of the client fingerprint
  deviceInfo      Json // { userAgent, platform, screen, timezone, language }
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprintHash])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("device_session")
}

// ─── Monitoring & alerting ───────────────────────────────────────────────────
// Configurable alert thresholds. Each row defines a metric, its severity tier,
// and the threshold that triggers an alert. Thresholds are stored here (not
// hardcoded) so operators can tune them without a code deploy.
model AlertConfig {
  id        String   @id @default(cuid())
  metric    String   @unique // e.g. "payment_success_rate", "refund_rate", "ledger_balance"
  tier      String   // "critical" | "high" | "medium"
  threshold Float    // the value that triggers the alert (meaning depends on metric)
  operator  String   @default(">=") // ">=" | "<=" | "==" | "abs_diff>"
  enabled   Boolean  @default(true)
  windowMin Int      @default(5) // rolling window in minutes for evaluation
  cooldownMin Int    @default(30) // min minutes between repeated alerts for same metric
  metadata  Json?    // extra config (e.g. { failureReason: "declined" })
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("alert_config")
}

// Append-only log of every alert that fired. This is the audit trail that
// proves the monitoring system actually catches things — not just that it
// exists. Auditors (BSL) can query this table directly.
model AlertLog {
  id         String   @id @default(cuid())
  metric     String   // matches AlertConfig.metric
  tier       String   // "critical" | "high" | "medium"
  threshold  Float    // the threshold that was breached
  actualValue Float   // the actual value at time of firing
  diff       Float?   // difference from threshold or baseline
  message    String   // human-readable description
  context    Json?    // additional data (dashboard link, related transaction IDs, etc.)
  firedAt    DateTime @default(now())

  @@index([metric])
  @@index([tier])
  @@index([firedAt])
  @@map("alert_log")
}

// Periodic metric snapshots for dashboard display and baseline comparison.
// Written by the monitoring cron jobs. Retained for 90 days, then swept.
model MetricSnapshot {
  id        String   @id @default(cuid())
  metric    String   // same keys as AlertConfig.metric
  value     Float    // computed metric value
  metadata  Json?    // extra breakdown (e.g. { byReason: { declined: 5, timeout: 2 } })
  windowStart DateTime
  windowEnd   DateTime
  createdAt DateTime @default(now())

  @@index([metric])
  @@index([createdAt])
  @@map("metric_snapshot")
}
