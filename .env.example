# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BETTER_AUTH_SECRET: Encryption secret key for Better Auth (at least 32 characters)
BETTER_AUTH_SECRET="abu-marketplace-secure-auth-secret-sl-2026-prod-token"

# BETTER_AUTH_API_KEY: Better Auth Infrastructure API key
BETTER_AUTH_API_KEY="ba_cn6v0fyinlj38h4q6t49ksdjmq8g9tqf"

# BETTER_AUTH_URL: Base URL for Better Auth routing
BETTER_AUTH_URL="https://abumarketplace.shop"

# GOOGLE OAUTH:
# Google OAuth Client ID for 1-Tap Google Account Chooser & GIS Sign-In
GOOGLE_CLIENT_ID="374984420075-6pak1vl4iu4s75u72sc03fglifpn3las.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="374984420075-6pak1vl4iu4s75u72sc03fglifpn3las.apps.googleusercontent.com"

# CLERK AUTHENTICATION:
# VITE_CLERK_PUBLISHABLE_KEY: Clerk Publishable Key (from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"

# REAL EMAIL DELIVERY (Direct to Gmail / Outlook / Yahoo):
# To deliver OTP verification emails directly to real customer inboxes (e.g. Gmail),
# configure an authenticated SMTP provider below (such as Gmail App Password, Resend, or SendGrid).
# If omitted, emails fall back to the safe virtual web preview sandbox (Ethereal).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
SMTP_FROM="ABU Marketplace Security <no-reply@abumarketplace.shop>"

# POSTGRES / SUPABASE DATABASE:
# DATABASE_URL: Session pooler connection string used by Better Auth.
# TLS certificates are verified by default against the bundled Supabase root CA
# (certs/supabase-root-2021-ca.pem). Append ?sslmode=disable for a local
# Postgres without TLS.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# DATABASE_SSL_CA (optional): Path to a CA bundle, or an inline PEM, to verify
# against instead of the bundled Supabase root CA.
# DATABASE_SSL_CA="/path/to/prod-ca.crt"

# DATABASE_SSL_MODE (optional): Same values as sslmode in DATABASE_URL, used when
# the URL has no sslmode. "no-verify" disables verification, "disable" turns TLS off.
# DATABASE_SSL_MODE="verify-full"

# DATABASE_SSL_NO_VERIFY (optional): Set to "true" to encrypt without verifying
# the server certificate. Insecure, only for debugging.
# DATABASE_SSL_NO_VERIFY="false"

# SUPABASE_URL: Project URL, used by the server-side admin client.
SUPABASE_URL="https://<project-ref>.supabase.co"

# SUPABASE_SECRET_KEY: Server-only secret key (service_role). Never expose to the browser.
SUPABASE_SECRET_KEY="<service-role-key>"

# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY: Browser client credentials.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-or-publishable-key>"

# STORE APPROVALS:
# ADMIN_EMAILS: Comma-separated addresses allowed to review store applications.
# Users whose profiles.role is 'admin' also get access.
# ADMIN_EMAILS="owner@abumarketplace.shop"

# SMTP: Transactional email for store submission / approval / rejection notices.
# When unset, messages are logged and recorded instead of delivered.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="resend"
SMTP_PASS="<provider-api-key>"
SMTP_FROM="ABU Marketplace <merchant@abumarketplace.shop>"
