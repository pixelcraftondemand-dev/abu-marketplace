# ── Clerk (Authentication) ─────────────────────────────────────────────────────
# Get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── App ────────────────────────────────────────────────────────────────────────
# Public URL used for origin validation (CORS/security)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin access (comma-separated emails)
ADMIN_EMAIL=admin@example.com

# Optional second layer for /admin and /api/admin: comma-separated IPv4
# addresses and/or CIDR ranges allowed to reach admin surfaces. When set,
# requests from any other IP get 403 before Clerk even runs. Leave empty to
# rely on Clerk + ADMIN_EMAIL alone.
# ADMIN_IP_ALLOWLIST=203.0.113.10,198.51.100.0/24

# ── Database (Supabase Postgres) ───────────────────────────────────────────────
# Use the Supabase pooler URL for DATABASE_URL and the direct database URL for DIRECT_URL.
#
# NOTE (verified 2026-08-08):
#   - Use the SESSION pooler (port 5432) on your project's actual pooler tier
#     (aws-0-… vs aws-1-…). The old `aws-0-[region]` format returns
#     "tenant not found" on aws-1 projects and the DIRECT_URL host
#     `db.<ref>.supabase.co` is IPv6-only (unreachable on IPv4-only networks),
#     which made every DB route (incl. /api/products) return 500.
#   - Copy the exact strings from Supabase Dashboard -> Project Settings ->
#     Database -> Connection string -> Pooler (session) + Direct.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-us-west-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# ── AMBER PAY (in-house payment system) ──────────────────────────────────────
# AMBER PAY is the marketplace's own financial system. No external gateway
# needed for the MVP — users fund wallets via agent cash-in, pay at checkout,
# and send P2P transfers.
#
# Platform fee rate (applied on all transactions)
AMBER_PAY_FEE_RATE=0.02
# Agent commission rate (applied on cash-in/cash-out)
AMBER_PAY_AGENT_COMMISSION=0.02
# Merchant platform fee (deducted from settlements)
AMBER_PAY_MERCHANT_FEE=0.05

# ── USSD Payment Processing ───────────────────────────────────────────────────
# USSD lets users without internet transact via dial codes (e.g. *123#).
# Critical for Sierra Leone where feature phones dominate.
#
# Provider: africastalking | beem | custom
USSD_PROVIDER=africastalking
USSD_SHORT_CODE=*123#
# Shared secret for webhook signature verification (optional in dev)
USSD_WEBHOOK_SECRET=

# Africa's Talking USSD config (https://africastalking.com)
AT_USSD_USERNAME=
AT_USSD_API_KEY=

# Beem Africa USSD config (https://beemafrica.com)
BEEM_USSD_SECRET=

# ── ImageKit (image uploads / CDN) ─────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── OpenAI (store AI product descriptions + support AI replies) ────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ── Inngest (background jobs; needed by the local `inngest dev` CLI) ───────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Resend (transactional email) ──────────────────────────────────────────────
# Get an API key from https://resend.com/api-keys
# NOTE: the from-address domain must be verified in Resend (only
# onboarding@resend.dev is allowed before you verify a domain).
RESEND_API_KEY=

# Support escalation destination and from-address
SUPPORT_EMAIL_TO=abumarketplace.shop@gmail.com
SUPPORT_EMAIL_FROM=ABU Marketplace <noreply@abumarketplace.shop>

# Customer-facing from-address (order confirmations). Must be a verified Resend
# domain (or onboarding@resend.dev before verification).
EMAIL_FROM=ABU Marketplace <noreply@abumarketplace.shop>

# Verification emails (Clerk OTP / account verification) — sent from the
# verification subdomain.
VERIFICATION_EMAIL_FROM=ABU Marketplace <noreply@verification.abumarketplace.shop>

# Account verification code lifetime in minutes (default 15, max 60).
VERIFICATION_OTP_TTL_MINUTES=15

# ── Google Translate (product / description translation) ───────────────────────
# Get an API key from https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=

# ── Open Exchange Rates (premium rate provider) ─────────────────────────────────
# Optional. When set, rates are fetched from Open Exchange Rates; otherwise the
# free exchangerate.host endpoint is used.
OPEN_EXCHANGE_RATES_APP_ID=
