# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# REAL EMAIL DELIVERY (Direct to Gmail / Outlook / Yahoo):
# To deliver OTP verification emails directly to real customer inboxes (e.g. Gmail),
# configure an authenticated SMTP provider below (such as Gmail App Password, Resend, or SendGrid).
# If omitted, emails fall back to the safe virtual web preview sandbox (Ethereal).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
SMTP_FROM="ABU Marketplace Security <no-reply@abumarketplace.shop>"

# SUPABASE DATABASE:
# SUPABASE_URL: Project URL, used by the server-side admin client.
SUPABASE_URL="https://<project-ref>.supabase.co"

# SUPABASE_SECRET_KEY: Server-only secret key (service_role). Never expose to the browser.
SUPABASE_SECRET_KEY="<service-role-key>"

# CLERK: the browser uses VITE_CLERK_PUBLISHABLE_KEY, the API uses CLERK_SECRET_KEY.
# Both must come from the same Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# CLERK_AUTHORIZED_PARTIES: origins whose sessions the server will trust. verifyToken
# compares the token's azp claim against this list, and the site canonicalises to
# the www host, so both spellings must be listed.
CLERK_AUTHORIZED_PARTIES="http://localhost:3000,https://abumarketplace.shop,https://www.abumarketplace.shop"

# ImageKit: server-only credentials for merchant store logo uploads.
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# LISTING PHOTOS (optional): prefix for property/land/vehicle listing photos that
# are stored as relative keys (e.g. "listings/ab-001.jpg"). Point it at a Supabase
# Storage bucket or CDN. Absolute https URLs in src/data/listingImages.ts ignore it.
# VITE_LISTING_IMAGE_CDN_BASE="https://<project-ref>.supabase.co/storage/v1/object/public/listings"

# STORE APPROVALS:
# ADMIN_EMAILS: Comma-separated addresses allowed to review store applications.
# Users whose profiles.role is 'admin' also get access.
# ADMIN_EMAILS="owner@abumarketplace.shop"

# RESEND: Transactional email for store submission / approval / rejection notices.
# When set, the mailer sends through Resend's HTTPS API. The From address must
# be on a verified domain in the Resend dashboard.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="ABU Marketplace <no-reply@verification.abumarketplace.shop>"

# SMTP (alternative to RESEND_API_KEY): used when no Resend key is present.
# When neither is set, messages are logged and recorded instead of delivered.
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="resend"
# SMTP_PASS="<resend-api-key>"
# SMTP_FROM="ABU Marketplace <no-reply@verification.abumarketplace.shop>"

# NOTE: Auth emails sent by Supabase (sign-up confirmation, magic codes) do NOT
# use this key. Configure Authentication > SMTP Settings in the Supabase
# dashboard, or disable "Confirm email" if you do not want that step.
