# ── Clerk (Authentication) ─────────────────────────────────────────────────────
# Get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── App ────────────────────────────────────────────────────────────────────────
# Public URL used for origin validation (CORS/security)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin access (comma-separated emails)
ADMIN_EMAIL=admin@example.com

# ── Database (Supabase Postgres) ───────────────────────────────────────────────
# Use the Supabase pooler URL for DATABASE_URL and the direct database URL for DIRECT_URL.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Stripe (payments) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── ImageKit (image uploads / CDN) ─────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── OpenAI (store AI product descriptions + support AI replies) ────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ── Inngest (background jobs; needed by the local `inngest dev` CLI) ───────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Resend (transactional email) ──────────────────────────────────────────────
# Get an API key from https://resend.com/api-keys
# NOTE: the from-address domain must be verified in Resend (only
# onboarding@resend.dev is allowed before you verify a domain).
RESEND_API_KEY=

# Support escalation destination and from-address
SUPPORT_EMAIL_TO=abumarketplace.shop@gmail.com
SUPPORT_EMAIL_FROM=ABU Marketplace <noreply@abumarketplace.shop>

# Customer-facing from-address (order confirmations). Must be a verified Resend
# domain (or onboarding@resend.dev before verification).
EMAIL_FROM=ABU Marketplace <noreply@abumarketplace.shop>

# Verification emails (Clerk OTP / account verification) — sent from the
# verification subdomain.
VERIFICATION_EMAIL_FROM=ABU Marketplace <noreply@verification.abumarketplace.shop>

# Account verification code lifetime in minutes (default 15, max 60).
VERIFICATION_OTP_TTL_MINUTES=15
