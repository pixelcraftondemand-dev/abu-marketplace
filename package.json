  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "doctor:serve": "node scripts/doctor.mjs --serve",
    "test:store-logo": "tsx --test tests/storeLogo.test.ts",
    "test:logo-image": "tsx --test tests/logoImage.test.ts",
    "test:session-user": "tsx --test tests/sessionUser.test.ts",
    "test:clerk-keys": "tsx --test tests/clerkKeys.test.ts",
    "test:health": "tsx --test tests/healthClerk.test.ts",
    "test:store-form-errors": "tsx --test tests/storeFormErrors.test.ts",
    "test:auth-retry": "tsx --test tests/apiAuthRetry.test.ts",
    "test:auth-rejection-codes": "tsx --test tests/authRejectionCodes.test.ts",
    "test:admin-access": "tsx --test tests/adminAccess.test.ts",
    "test:store-lifecycle": "tsx --test tests/storeLifecycle.test.ts",
    "test:merchant-applications-http": "tsx --test tests/merchantApplicationsHttp.test.ts",
    "test:approval-email": "tsx --test tests/approvalEmail.test.ts",
    "test:merchant-dashboard": "tsx --test tests/merchantDashboard.test.ts",
    "test:application-inbox": "tsx --test tests/applicationInbox.test.ts",
    "test:merchant-hub-tabs": "tsx --test tests/merchantHubTabs.test.ts",
    "test:upload-diagnostics": "tsx --test tests/uploadDiagnostics.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "sync:github": "git fetch origin main && git merge origin/main --no-edit"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
