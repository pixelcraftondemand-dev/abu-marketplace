    "@sanity/client": "^7.27.0",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "6.18.0",
    "@sentry/nextjs": "^10.69.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^13.1.1",
    "imagekit": "^6.0.0",
    "inngest": "^3.54.0",
    "lucide-react": "^0.525.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-sanity": "13.3.4",
    "openai": "^5.23.2",
    "puppeteer": "24.43.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-is": "^19.0.0",
    "react-redux": "^9.2.0",
    "recharts": "^3.1.2",
    "resend": "^6.18.1",
    "sanity": "6.18.0",
