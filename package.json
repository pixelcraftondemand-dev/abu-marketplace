    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "husky": "^9.1.7",
    "prisma": "6.12.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
