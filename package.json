{
  "name": "abu_marketplace",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/lib tests/middlewares",
    "test:integration": "vitest run tests/api tests/inngest",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.js",
    "test:security": "node scripts/security-scan.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:load": "k6 run tests/load/pilot-load.js",
    "test:pilot": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:smoke",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
